             C = f(A, B, offs)
         self.assertEqual(C, C_ref)

+    @unittest.skipIf(TEST_WITH_ROCM, "fp32 output uses the CUTLASS grouped GEMM")
+    @unittest.skipIf(
+        not TEST_CUDA or torch.cuda.get_device_capability()[0] not in (9, 10),
+        "CUTLASS grouped GEMM with fp32 output requires SM 9.x or 10.x",
+    )
+    @parametrize("op", ["2d/2d", "2d/3d"])
+    def test_grouped_gemm_bf16_inputs_fp32_output(self, op):
+        # bf16 products are exact in fp32 and the kernel accumulates in fp32, so an fp32 output
+        # keeps the bits a bf16 output rounds away (e.g. for fp32 weight gradients).
+        device = "cuda"
+        m, n, k, ngroups = 64, 48, 32, 4
+        offs = torch.tensor([16, 16, 40, 64], device=device, dtype=torch.int32)
+        if op == "2d/2d":
+            # weight gradient: grad_output.T @ input per group
+            A = torch.randn(m, n, device=device, dtype=torch.bfloat16).t()
+            B = torch.randn(m, k, device=device, dtype=torch.bfloat16)
+        else:
+            # forward: input @ weight.T per group
+            A = torch.randn(m, k, device=device, dtype=torch.bfloat16)
+            B = torch.randn(ngroups, n, k, device=device, dtype=torch.bfloat16).transpose(-2, -1)
+        C = torch._grouped_mm(A, B, offs=offs, out_dtype=torch.float32)
+        C_ref = self.grouped_gemm_reference(A.double(), B.double(), offs)
+        self.assertEqual(C.dtype, torch.float32)
+        self.assertEqual(C.double(), C_ref, atol=1e-5, rtol=1e-5)
+
